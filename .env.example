# Either set these, or store them in the macOS Keychain (service names in brackets).
APOLLO_API_KEY=           # [apollo-api-key]    Apollo API key (Settings > Integrations > API)
SMARTLEAD_API_KEY=        # [smartlead-api-key] Smartlead API key (Settings)
ANTHROPIC_API_KEY=        # [anthropic-api-key]
OUTREACH_WEBHOOK_TOKEN=   # long random string; Smartlead calls https://your-host/smartlead?token=<this>
OUTREACH_CONFIG=campaign.json
OUTREACH_DATA=data
